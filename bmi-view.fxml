<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.kalkulatorbmi.BmiController"
      alignment="TOP_CENTER"
      spacing="16"
      styleClass="root-pane">

    <padding>
        <Insets top="28" right="34" bottom="28" left="34"/>
    </padding>

    <Label text="Kalkulator BMI" styleClass="title-label"/>
    <Label text="Body Mass Index" styleClass="subtitle-label"/>

    <VBox spacing="7" maxWidth="420">
        <Label text="Berat badan (kg)" styleClass="field-label"/>
        <TextField fx:id="beratField"
                   promptText="Contoh: 55"
                   accessibleText="Berat badan dalam kilogram"/>
    </VBox>

    <VBox spacing="7" maxWidth="420">
        <Label text="Tinggi badan (cm)" styleClass="field-label"/>
        <TextField fx:id="tinggiField"
                   promptText="Contoh: 165"
                   accessibleText="Tinggi badan dalam sentimeter"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER" maxWidth="420">
        <Button text="Hitung BMI"
                onAction="#hitungBMI"
                defaultButton="true"
                styleClass="primary-button"
                HBox.hgrow="ALWAYS"
                maxWidth="Infinity"/>
        <Button text="Reset"
                onAction="#resetForm"
                styleClass="secondary-button"/>
    </HBox>

    <Label fx:id="pesanLabel" text="" wrapText="true" styleClass="message-label"/>

    <VBox alignment="CENTER" spacing="8" styleClass="result-card" maxWidth="420">
        <Label text="HASIL BMI" styleClass="result-heading"/>
        <Label fx:id="hasilLabel" text="--" styleClass="result-number"/>
        <Label fx:id="kategoriLabel"
               text="Hasil akan muncul di sini"
               wrapText="true"
               styleClass="category-label"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Label text="Catatan: kategori di atas menggunakan acuan umum BMI dewasa."
           wrapText="true"
           styleClass="footer-label"/>
</VBox>
